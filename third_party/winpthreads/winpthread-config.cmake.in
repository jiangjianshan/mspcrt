@PACKAGE_INIT@

set_and_check(pthread_INCLUDEDIR "@PACKAGE_INCLUDE_INSTALL_DIR@")

if(NOT TARGET pthread::pthread_shared AND NOT TARGET pthread::pthread_static)
  include(${CMAKE_CURRENT_LIST_DIR}/pthread-targets.cmake)
endif()

set(pthread_SHARED_LIBRARIES pthread::pthread_shared)
set(pthread_STATIC_LIBRARIES pthread::pthread_static)
set(pthread_INCLUDE_DIRS ${pthread_INCLUDEDIR})

set(WINPTHREAD_LIBRARIES pthread::pthread_shared)
set(WINPTHREAD_INCLUDE_DIRS ${pthread_INCLUDEDIR})
